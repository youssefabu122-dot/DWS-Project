MYSQL_ROOT_PASSWORD=rosca_local_root_change_me
MYSQL_PASSWORD=rosca_local_app_change_me
# D9: secret used to sign JWTs. Use a long random value (at least 32 characters), e.g. `openssl rand -hex 32`. Never commit the real value.
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars
# D10: MongoDB activity feed. Root is only used by the init script; the backend uses the app account.
MONGO_ROOT_PASSWORD=rosca_local_mongo_root_change_me
MONGO_APP_PASSWORD=rosca_local_mongo_app_change_me
